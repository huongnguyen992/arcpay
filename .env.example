# ── Blockchain ──────────────────────────────────────────────────────
# Private key của ví dùng để deploy contract (KHÔNG có dấu 0x ở đầu cũng được)
# ⚠️ KHÔNG bao giờ commit file .env thật lên GitHub!
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ── Frontend (Vite) ─────────────────────────────────────────────────
# URL của backend API khi deploy production (Railway)
# Ví dụ: https://arcpay-api.up.railway.app
VITE_API_URL=http://localhost:3001

# ── Backend ──────────────────────────────────────────────────────────
PORT=3001
