# Arc App Kit - Environment Variables
# Copy this file to .env.local and fill in your values

# Your wallet private key (for server-side operations)
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Circle Console Kit Key (required for Swap)
KIT_KEY=YOUR_KIT_KEY_HERE

# Next.js public env vars (exposed to browser)
NEXT_PUBLIC_CHAIN=Arc_Testnet
